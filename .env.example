# Database
DATABASE_URL=postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&pgbouncer=true
NEXT_PUBLIC_APP_URL=https://mackhen-farm.vercel.app

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Vercel/NextAuth-compatible fallback; AUTH_SECRET takes precedence when both exist.
NEXTAUTH_SECRET=

APP_URL=http://localhost:3000

# Gmail SMTP for password reset (use a Google App Password)
SMTP_USER=
SMTP_PASSWORD=

# Optional AI shopping assistant providers; knowledge fallback works without either key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional VietQR account overrides
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NUMBER=0762793244
VIETQR_ACCOUNT_NAME=TRAN TRUNG CHAU

# Add the real support phone before publishing
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_ZALO_URL=

# Set true only after verifying the store's registration
NEXT_PUBLIC_MOIT_REGISTERED=false
