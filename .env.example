# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Vercel/NextAuth-compatible fallback; AUTH_SECRET takes precedence when both exist.
NEXTAUTH_SECRET=

# PayOS (optional when using direct VietQR fallback)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# MoMo IPN verification (configure the callback URL in the MoMo merchant portal)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
APP_URL=http://localhost:3000

# Optional Gmail SMTP for password-reset OTP (use a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional AI shopping assistant providers; knowledge fallback works without either key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional VietQR account overrides
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NUMBER=0762793244
VIETQR_ACCOUNT_NAME=TRAN TRUNG CHAU

# Add the real support phone before publishing
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_ZALO_URL=

# Set true only after verifying the store's registration
NEXT_PUBLIC_MOIT_REGISTERED=false
