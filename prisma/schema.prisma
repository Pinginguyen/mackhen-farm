generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PROCESSING
  HANDED_OFF
  IN_TRANSIT
  SHIPPING
  COMPLETED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum CheckoutPaymentMethod {
  COD
  VIETQR
  MOMO
}

enum ShippingCarrier {
  GHTK
  SPX
  VIETTEL_POST
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  role      UserRole @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  category      String
  price         Int
  originalPrice Int?
  unit          String?
  weight        Int?
  protein       String?
  calories      Int?
  images        String[]         @default([])
  rating        Float            @default(0)
  stock         Int              @default(0)
  description   String
  image         String
  highlight     String
  badge         String?
  highlights    String[]         @default([])
  nutritionFacts Json?
  active        Boolean          @default(true)
  variants      ProductVariant[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
    productionLots ProductionLot[]

  @@index([active, category])
}

model ProductVariant {
  id        String      @id @default(cuid())
  productId String
  label     String
  price     Int
  weight    String
  stock     Int         @default(0)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([productId, label])
  @@index([productId])
}

model ProductionLot {
  id            String   @id @default(cuid())
  lotCode       String   @unique
  productId     String
  mfgDate       DateTime
  expDate       DateTime
  receivedQty   Int
  availableQty  Int
  status        String   @default("ACTIVE")
  testReportUrl String?
  receivingNote String?
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId, status, expDate])
}
model Cart {
  id        String     @id
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id               String          @id @default(cuid())
  cartId           String
  productId        String
  productVariantId String?
  quantity         Int
  unitPrice        Int
  productName      String
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReturnRequestStatus {
  PENDING
  REPLACEMENT_APPROVED
  VOUCHER_ISSUED
  REFUND_APPROVED
  REFUNDED
  COMPLETED
  REJECTED
}

model Order {
  id            String               @id @default(cuid())
  orderCode     String               @unique
  numericCode   Int                  @unique @default(autoincrement())
  userId        String?
  customerId    String?
  customerName  String
  phone         String
  address       String
  orderStatus   OrderStatus          @default(PENDING) @map("status")
  paymentMethod CheckoutPaymentMethod @default(COD)
  paymentStatus PaymentStatus        @default(PENDING)
  subtotal      Int
  shippingFee   Float                @map("shipping")
  discountAmount Float               @default(0)
  voucherCode   String?
  totalAmount   Int                  @map("total")
  idempotencyKey String?              @unique
  lotCode       String?
  grossAmount   Float                 @default(0)
  netAmount     Float                 @default(0)
  reconciled    Boolean               @default(false)
  holdExpiresAt DateTime?
  note          String?
  trackingCode  String?
  deliveredAt   DateTime?
  carrier       ShippingCarrier?
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  warrantyRequest WarrantyRequest?
  returnRequests ReturnRequest[]
  refundOperations RefundOperation[]
  compensationVouchers CompensationVoucher[]
  reviews       Review[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orderStatus, createdAt])
  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@index([phone, createdAt])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String?
  productName      String
  variantLabel     String?
  quantity         Int
  price            Int             @map("unitPrice")
  lineTotal        Int
  lotCode          String?
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Review {
  id           String   @id @default(cuid())
  orderId      String?
  productId    String
  customerName String
  rating       Int
  comment      String
  riskTag      String?
  riskAnalyzedAt DateTime?
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, productId])
  @@index([productId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  orderCode   Int           @unique @default(autoincrement())
  externalId  String?       @unique
  amount      Int
  currency    String        @default("VND")
  status      PaymentStatus @default(PENDING)
  checkoutUrl String?
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId, status])
}

model WarrantyRequest {
  id        String   @id @default(cuid())
  orderId   String   @unique
  reason    String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ReturnRequest {
  id            String              @id @default(cuid())
  orderId       String
  customerPhone String
  issueType     String
  description   String
  imageUrl      String?
  refundBankName String?
  refundAccountNumber String?
  refundAccountHolder String?
  refundApprovedBy String?
  refundApprovedAt DateTime?
  refundCompletedBy String?
  refundTransferReference String?
  riskTag       String?
  riskAnalyzedAt DateTime?
  status        ReturnRequestStatus @default(PENDING)
  adminNote     String?
  createdAt     DateTime            @default(now())
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundOperations RefundOperation[]
  compensationVoucher CompensationVoucher?

  @@index([status, createdAt])
  @@index([orderId])
}

model AuditLog {
  id           String   @id @default(cuid())
  adminEmail   String
  action       String
  targetEntity String
  targetId     String
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([targetEntity, targetId, createdAt])
  @@index([adminEmail, createdAt])
}

model RefundOperation {
  id                   String   @id @default(cuid())
  orderId              String
  returnRequestId      String?
  amount               Int
  bankName             String
  accountNumber        String
  accountHolder        String
  reason               String
  status               String   @default("PENDING_APPROVAL")
  requestedBy          String
  approvedBy           String?
  approvedAt           DateTime?
  transferReference    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequest        ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId, createdAt])
}

model CompensationVoucher {
  id              String        @id @default(cuid())
  code            String        @unique
  orderId         String
  returnRequestId String        @unique
  customerPhone   String
  discountPercent Int           @default(50)
  expiresAt       DateTime
  redeemedAt      DateTime?
  createdBy       String
  createdAt       DateTime      @default(now())
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@index([customerPhone, expiresAt, redeemedAt])
}

model Voucher {
  id             String              @id @default(cuid())
  code           String              @unique
  name           String?
  discountType   VoucherDiscountType
  value          Int
  maxDiscount    Int?
  minSpend       Int                 @default(0)
  expiresAt      DateTime?
  isActive       Boolean             @default(true)
  usedCount      Int                 @default(0)
  usageLimit     Int?
  freeShipping   Boolean             @default(false)
  firstOrderOnly Boolean             @default(false)
  showOnPromoPage Boolean            @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([isActive, expiresAt])
}