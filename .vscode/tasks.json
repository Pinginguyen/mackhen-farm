{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Emulators",
      "type": "shell",
      "command": "docker compose up -d",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "bohoch-store dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/bohoch",
          "NEXT_TELEMETRY_DISABLED": "1"
        }
      },
      "dependsOn": [
        "Start Emulators"
      ],
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      },
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\s*ready",
          "endsPattern": "started server on"
        }
      }
    }
  ]
}
