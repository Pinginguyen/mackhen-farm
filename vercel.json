{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/affiliate-commission-holds",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/review-requests",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/abandoned-carts",
      "schedule": "0 * * * *"
    }
  ]
}